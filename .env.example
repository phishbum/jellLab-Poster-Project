# Server-side only. Never put a real key in this file.
OpenAI_API_key=

# Optional model override.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# Supplied automatically when the private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Supplied automatically when the Neon database is connected through Vercel Marketplace.
DATABASE_URL=

# Stripe server-side credentials. Store as sensitive Vercel environment variables.
# Prefer a restricted key with only the Checkout permissions this app needs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
